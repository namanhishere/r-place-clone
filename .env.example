# --- Server ---
PORT=8980
NODE_ENV=development

# --- Session / JWT ---
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# --- Discord OAuth2 ---
# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# Must EXACTLY match a redirect URI registered in the Discord app settings.
DISCORD_REDIRECT_URI=http://localhost:8980/auth/callback

# --- Admin access ---
# Comma-separated Discord user IDs allowed into /admin.html and admin APIs.
ADMIN_DISCORD_IDS=123456789012345678,987654321098765432

# --- Security ---
# Comma-separated origins allowed to make WebSocket connections and admin/logout
# mutations (CSRF defense). Leave EMPTY to allow same-origin only (recommended for
# single-domain deploys). Set when the site is served from a different origin than
# the API, e.g. https://lauplace.namanhishere.com
ALLOWED_ORIGINS=

# --- Branding ---
# Every user-facing brand string is driven from here. Change once, applies to
# both the public page and the admin dashboard.
BRAND_NAME=lẩu/Place
# Lowercase variant used in social share (OG/Twitter) titles. Defaults to BRAND_NAME lowercased.
BRAND_NAME_LOWER=lẩu/place
# Admin dashboard title. Defaults to "<BRAND_NAME> Admin".
BRAND_ADMIN_NAME=lẩu/Place Admin
# Short tagline shown in social share cards.
BRAND_DESCRIPTION=Place thập cẩm
# Small label next to the title in the navbar, e.g. "Beta Session".
BRAND_SESSION_LABEL=Beta Session
# Canonical site URL (used for og:url). Leave empty if unknown.
BRAND_URL=https://lauplace.namanhishere.com/
# Social share image. Defaults to <BRAND_URL>/banner.png when empty.
BRAND_IMAGE=https://lauplace.namanhishere.com/banner.png

# --- Legacy superpaint (still supported via admin dashboard) ---
SUPERPAINT_SECRET_KEY=optional-legacy-key
